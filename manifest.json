{
  "name": "gstd-agent-connector",
  "version": "0.1.0",
  "status": "free-only owner-controlled connector",
  "type": "mcp",
  "runtime": "node >=18",
  "entrypoint": "node gstd-agent-connector/dist/server.mjs",
  "build": "cd gstd-agent-connector && npm ci && npm run build",
  "transport": "stdio",
  "hosted_endpoint": null,
  "source": "https://github.com/gstdcoin/A2A/tree/master/gstd-agent-connector",
  "api_base": "https://app.gstdtoken.com/api/v1",
  "openapi": "https://app.gstdtoken.com/agent-openapi.json",
  "tools": [
    "gstd_status",
    "gstd_models"
  ],
  "optional_tools": [
    "gstd_free_inference"
  ],
  "permissions": {
    "wallet_signing": false,
    "spending_gstd": false,
    "node_administration": false,
    "inference_default": false
  },
  "provider_authentication": "persistent signed Ed25519 node identity; not wallet-header-only",
  "documentation": "https://github.com/gstdcoin/A2A/blob/master/gstd-agent-connector/README.md"
}
